# {{ ansible_managed }}
# Environment: {{ ome_env }} (follows branch `{{ ome_branch }}` of the fork)
#
# Differences with upstream docker-compose.yml:
# - NNTP, API and frontend come from GHCR: nothing is built on the server.
# - No source code mounted as volumes: the server runs what is in the images.
# - INN keeps its articles, history and backlog in the volumes nntp-db and nntp-spool,
#   so a new image (or Watchtower) keeps them.
# - The real config.json (rendered by Ansible from the vault) is mounted as the
#   `ome_config` secret at /run/secrets/ome_config, so no credentials are in images.
# - FastAPI runs with `fastapi run` (production mode) on port 8000, the port
#   the frontend's nginx proxies /api/ to.
# - NNTP is published on the host only when the node has peers (see nntp-server).
# - Watchtower updates NNTP, API and frontend when a new image is published.

name: ome

services:
  nntp-server:
    image: {{ ome_nntp_image }}
    pull_policy: missing
    hostname: nntp-server
    secrets:
      - ome_config
    restart: unless-stopped
    # innd needs a few seconds to stop, and waits for innfeed to save the backlog.
    stop_grace_period: 30s
    volumes:
      - nntp-db:/var/lib/news
      - nntp-spool:/var/spool/news
    labels:
      com.centurylinklabs.watchtower.enable: "true"
    networks:
      ome_net:
        ipv4_address: 172.21.0.2
{% if ome_nntp_peers | length > 0 %}
    # Published only when this node has peers, and only on IPv4: on IPv6,
    # docker-proxy would pass the traffic on without DNAT, so the nftables
    # table ome_nntp (role ome, ome-nntp-peers.nft) could not filter it.
    # The table lets only the peers through.
    ports:
      - "0.0.0.0:{{ ome_nntp_port }}:119"
{% else %}
    # No peers, so don't publish the NNTP port on the host.
{% endif %}

  fastapi-server:
    image: {{ ome_api_image }}
    pull_policy: missing
    hostname: fastapi-server
    restart: unless-stopped
    command: ["uv", "run", "--env-file=.env", "fastapi", "run", "--host=0.0.0.0", "--port=8000", "server/main.py"]
    environment:
      INN_SERVER_NAME: nntp-server
    secrets:
      - ome_config
    labels:
      com.centurylinklabs.watchtower.enable: "true"
    depends_on:
      # The API connects to INN when it starts: wait until INN accepts articles.
      nntp-server:
        condition: service_healthy
        restart: true
    networks:
      ome_net:
        ipv4_address: 172.21.0.3

  imls-react:
    image: {{ ome_frontend_image }}
    pull_policy: missing
    restart: unless-stopped
    ports:
      - "{{ ome_frontend_port }}:80"
    labels:
      com.centurylinklabs.watchtower.enable: "true"
    depends_on:
      - fastapi-server
    networks:
      ome_net:
        ipv4_address: 172.21.0.4

  watchtower:
    image: {{ ome_watchtower_image }}
    restart: unless-stopped
    # --label-enable: only update containers labelled above (not Watchtower itself).
    # --stop-timeout: as stop_grace_period of NNTP, so innd can stop cleanly.
    # --cleanup: remove the old image after an update.
    command: ["--label-enable", "--stop-timeout", "30s", "--cleanup", "--interval", "{{ ome_watchtower_interval }}"]
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock

secrets:
  ome_config:
    file: {{ ome_base_dir }}/config.json

volumes:
  nntp-db:
  nntp-spool:

networks:
  ome_net:
    driver: bridge
    ipam:
      config:
        - subnet: {{ ome_network_subnet }}
          gateway: {{ ome_network_gateway }}
